# ColdReach AI Environment Variables
# Copy this file to .env.local and populate with your Google Cloud credentials.

# Database: SQLite is default for zero-setup local storage.
# For PostgreSQL: DATABASE_URL="postgresql://user:password@localhost:5432/coldreach?schema=public"
DATABASE_URL="file:./coldreach.db"

# Public App URL (used for OAuth redirect callbacks)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google OAuth 2.0 Credentials (from Google Cloud Console -> APIs & Services -> Credentials)
# Authorized redirect URI must be set to: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# 32-byte Hex Encryption Key (64 hex characters) used to encrypt Google OAuth tokens at rest with AES-256-GCM.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Storage configuration for uploaded resumes (stored privately, NOT in /public)
UPLOAD_DIR="./uploads/resumes"
MAX_UPLOAD_SIZE_MB=25

# Campaign Sending Limits
DEFAULT_SEND_INTERVAL_SEC=3
DAILY_SEND_LIMIT=500
